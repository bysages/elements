{
  "name": "@bysages/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "By Sages Elements monorepo — accessible UI components styled by design tokens, responsive via container queries, with a dynamic lighting engine, shipped as React, Vue, Solid, and Svelte components",
  "keywords": [
    "a11y",
    "accessible",
    "component-library",
    "components",
    "container-queries",
    "css",
    "design-system",
    "design-tokens",
    "headless",
    "lighting-engine",
    "react",
    "solid",
    "svelte",
    "theming",
    "tokens",
    "typescript",
    "ui",
    "ui-components",
    "vue"
  ],
  "homepage": "https://github.com/bysages/elements#readme",
  "bugs": {
    "url": "https://github.com/bysages/elements/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/elements.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"./packages/**\" -r dev",
    "build": "pnpm --filter \"./packages/**\" -r build",
    "check": "vp check --fix",
    "test": "vp test run",
    "bench": "vp test bench",
    "docs:content": "node docs/scripts/generate-component-docs.ts",
    "docs:content:check": "node docs/scripts/generate-component-docs.ts --check",
    "version": "pnpm --filter \"./packages/**\" -r exec basis version",
    "postinstall": "pnpm build && vp config && basis git setup",
    "release": "pnpm --filter \"./packages/**\" -r run release"
  },
  "devDependencies": {
    "@funish/basis": "0.3.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "ts-morph": "28.0.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vite-plus": "0.3.2",
    "vue-tsc": "3.3.11"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
