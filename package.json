{
  "name": "@bysages/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "By Sages Elements monorepo — accessible UI components styled by design tokens, responsive via container queries, with a dynamic lighting engine, shipped as React, Vue, Solid, and Svelte components",
  "keywords": [
    "a11y",
    "accessible",
    "component-library",
    "components",
    "container-queries",
    "css",
    "design-system",
    "design-tokens",
    "headless",
    "lighting-engine",
    "react",
    "solid",
    "svelte",
    "theming",
    "tokens",
    "typescript",
    "ui",
    "ui-components",
    "vue"
  ],
  "homepage": "https://github.com/bysages/elements#readme",
  "bugs": {
    "url": "https://github.com/bysages/elements/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/elements.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"./packages/*\" -r dev",
    "build": "pnpm --filter \"./packages/*\" -r build",
    "check": "vp check --fix",
    "test": "vp test run",
    "bench": "vp test bench",
    "docs:content": "tsx docs/scripts/generate-component-docs.ts",
    "docs:content:check": "tsx docs/scripts/generate-component-docs.ts --check",
    "version": "pnpm --filter \"./packages/*\" -r exec basis version",
    "postinstall": "pnpm build && vp config && basis git setup",
    "release": "pnpm --filter \"./packages/*\" -r run release",
    "generate:generative": "tsx scripts/generate-generative-faces.ts"
  },
  "devDependencies": {
    "@funish/basis": "0.3.0",
    "@nuxt/devtools-kit": "3.4.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "ts-morph": "28.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite-plus": "1.4.0",
    "vue-tsc": "3.3.14"
  },
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32"
}
