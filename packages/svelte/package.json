    "@tanstack/svelte-table": "9.2.4",
    "@tanstack/svelte-virtual": "3.13.39",
    "@zag-js/cascade-select": "1.44.0",
    "@zag-js/svelte": "1.44.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "ai": "7.0.107",
    "rollup-plugin-svelte": "7.2.3",
    "svelte": "5.57.1",
    "svelte2tsx": "0.7.61"
  },
  "peerDependencies": {
    "svelte": "^5"
  }
