{
  "name": "@bysages/svelte",
  "version": "0.4.4",
  "description": "By Sages Elements components for Svelte — styled by the paper-and-ink design tokens",
  "keywords": [
    "accessible",
    "components",
    "css",
    "design-system",
    "design-tokens",
    "svelte",
    "theming",
    "ui",
    "ui-components"
  ],
  "homepage": "https://github.com/bysages/elements#readme",
  "bugs": {
    "url": "https://github.com/bysages/elements/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/elements.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./generative": {
      "types": "./dist/generative/index.d.mts",
      "import": "./dist/generative/index.mjs"
    }
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "tsx scripts/emit-svelte-dts.ts && vp pack",
    "prepack": "pnpm build",
    "release": "basis publish"
  },
  "dependencies": {
    "@ark-ui/svelte": "5.25.0",
    "@bysages/core": "workspace:*",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/svelte-form": "1.33.5",
    "@tanstack/svelte-table": "9.3.1",
    "@tanstack/svelte-virtual": "3.13.50",
    "@zag-js/cascade-select": "1.47.0",
    "@zag-js/svelte": "1.47.0"
  },
  "devDependencies": {
    "@json-render/core": "0.21.3",
    "@json-render/svelte": "0.21.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "ai": "7.0.159",
    "rollup-plugin-svelte": "7.2.3",
    "svelte": "5.57.3",
    "svelte2tsx": "0.7.62",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@json-render/core": "^0.21.0",
    "@json-render/svelte": "^0.21.0",
    "svelte": "^5",
    "zod": "^4.0"
  },
  "peerDependenciesMeta": {
    "@json-render/core": {
      "optional": true
    },
    "@json-render/svelte": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}