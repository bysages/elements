{
  "name": "@bysages/react",
  "version": "0.4.1",
  "description": "By Sages Elements components for React — styled by the paper-and-ink design tokens",
  "keywords": [
    "accessible",
    "components",
    "css",
    "design-system",
    "design-tokens",
    "react",
    "react-components",
    "theming",
    "ui",
    "ui-components"
  ],
  "homepage": "https://github.com/bysages/elements#readme",
  "bugs": {
    "url": "https://github.com/bysages/elements/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/elements.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./generative": {
      "types": "./dist/generative/index.d.mts",
      "import": "./dist/generative/index.mjs"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vp pack",
    "build:workbench": "storybook build -o ../../docs/public/storybook/react",
    "prepack": "pnpm build",
    "release": "basis publish"
  },
  "dependencies": {
    "@ark-ui/react": "5.39.3",
    "@bysages/core": "workspace:*",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-table": "9.2.8",
    "@tanstack/react-virtual": "3.14.14",
    "@zag-js/cascade-select": "1.45.0",
    "@zag-js/react": "1.45.0"
  },
  "devDependencies": {
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "7.0.137",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@json-render/core": "^0.21.0",
    "@json-render/react": "^0.21.0",
    "react": ">=18",
    "react-dom": ">=18",
    "zod": "^4.0"
  },
  "peerDependenciesMeta": {
    "@json-render/core": {
      "optional": true
    },
    "@json-render/react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
