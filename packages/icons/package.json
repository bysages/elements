{
  "name": "@bysages/icons",
  "version": "0.2.2",
  "description": "Icon registry for By Sages Elements — iconify-format glyphs drawn from a curated collection, one canonical set for every framework wrapper",
  "keywords": [
    "design-system",
    "iconify",
    "icons",
    "ui"
  ],
  "homepage": "https://github.com/bysages/elements#readme",
  "bugs": {
    "url": "https://github.com/bysages/elements/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/elements.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "basis build --stub",
    "build": "vp pack",
    "prepack": "pnpm build",
    "release": "basis publish"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.132",
    "@iconify/types": "2.0.0",
    "@iconify/utils": "3.1.7"
  }
}
