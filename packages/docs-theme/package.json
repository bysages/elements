{
  "name": "@bysages/docs-theme",
  "version": "0.6.0",
  "description": "Documentation theme for By Sages Elements — a Nuxt Content layer that turns a content folder into a paper-and-ink docs site",
  "keywords": [
    "design-system",
    "design-tokens",
    "docs",
    "documentation",
    "nuxt",
    "nuxt-content",
    "nuxt-layer",
    "theming",
    "ui"
  ],
  "homepage": "https://github.com/bysages/elements#readme",
  "bugs": {
    "url": "https://github.com/bysages/elements/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/elements"
  },
  "files": [
    "app",
    "assets",
    "i18n",
    "modules",
    "server",
    "utils",
    "content.config.ts",
    "nuxt.config.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./nuxt.config.ts"
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "nuxt prepare",
    "typecheck": "nuxt typecheck .",
    "release": "basis publish"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.99",
    "@ai-sdk/openai-compatible": "3.0.92",
    "@ai-sdk/vue": "4.0.173",
    "@bysages/nuxt": "workspace:*",
    "@bysages/tokens": "workspace:*",
    "@bysages/vue": "workspace:*",
    "@iconify-json/lucide": "1.2.155",
    "@iconify-json/simple-icons": "1.2.102",
    "@nuxt/content": "3.16.2",
    "@nuxt/icon": "2.6.2",
    "@nuxt/kit": "4.6.4",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/mcp-toolkit": "0.24.3",
    "@nuxtjs/robots": "7.0.2",
    "@nuxtjs/sitemap": "9.1.0",
    "@tanstack/highlight": "1.2.12",
    "agents": "0.33.0",
    "ai": "7.0.173",
    "better-sqlite3": "13.2.0",
    "minisearch": "7.2.0",
    "nuxt-agent-discovery": "0.8.2",
    "nuxt-llms": "0.3.2",
    "nuxt-og-image": "7.0.7",
    "nuxt-schema-org": "7.0.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
