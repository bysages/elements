{
  "name": "@bysages/docs-theme",
  "version": "0.4.4",
  "description": "Documentation theme for By Sages Elements — a Nuxt Content layer that turns a content folder into a paper-and-ink docs site",
  "keywords": [
    "design-system",
    "design-tokens",
    "docs",
    "documentation",
    "nuxt",
    "nuxt-content",
    "nuxt-layer",
    "theming",
    "ui"
  ],
  "homepage": "https://github.com/bysages/elements#readme",
  "bugs": {
    "url": "https://github.com/bysages/elements/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/elements"
  },
  "files": [
    "app",
    "assets",
    "i18n",
    "modules",
    "server",
    "utils",
    "content.config.ts",
    "nuxt.config.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./nuxt.config.ts"
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "nuxt prepare",
    "typecheck": "nuxt typecheck .",
    "release": "basis publish"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.88",
    "@ai-sdk/openai-compatible": "3.0.82",
    "@ai-sdk/vue": "4.0.159",
    "@bysages/nuxt": "workspace:*",
    "@bysages/tokens": "workspace:*",
    "@bysages/vue": "workspace:*",
    "@iconify-json/lucide": "1.2.149",
    "@nuxt/content": "3.16.2",
    "@nuxt/icon": "2.6.2",
    "@nuxt/kit": "4.6.3",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/mcp-toolkit": "0.24.3",
    "@nuxtjs/robots": "6.2.4",
    "@nuxtjs/sitemap": "8.6.2",
    "@tanstack/highlight": "1.2.0",
    "agents": "0.32.0",
    "ai": "7.0.159",
    "better-sqlite3": "13.0.3",
    "minisearch": "7.2.0",
    "nuxt-agent-discovery": "0.8.1",
    "nuxt-llms": "0.3.1",
    "nuxt-og-image": "6.10.4",
    "nuxt-schema-org": "6.4.3",
    "tailwindcss": "4.3.3",
