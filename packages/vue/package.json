    "@zag-js/vue": "1.47.0"
  },
  "devDependencies": {
    "@json-render/core": "0.21.3",
    "@json-render/vue": "0.21.3",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/vue3-vite": "10.6.5",
    "ai": "7.0.159",
    "storybook": "10.6.5",
