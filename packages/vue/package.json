    "build:workbench": "storybook build -o ../../docs/public/storybook",
    "prepack": "pnpm build",
    "release": "basis publish"
  },
  "dependencies": {
    "@ark-ui/vue": "5.40.0",
    "@bysages/core": "workspace:*",
    "@tanstack/markdown": "1.0.0",
    "@tanstack/vue-form": "1.33.5",
    "@tanstack/vue-table": "9.3.1",
    "@tanstack/vue-virtual": "3.13.50",
