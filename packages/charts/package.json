{
  "name": "@bysages/charts",
  "version": "0.0.0",
  "description": "Token-themed charts for By Sages Elements — TanStack Charts dressed in the paper-and-ink system: one token bridge plus thin framework adapters",
  "keywords": [
    "charts",
    "components",
    "data-visualization",
    "dataviz",
    "design-system",
    "design-tokens",
    "theming",
    "ui",
    "vue"
  ],
  "homepage": "https://github.com/bysages/elements#readme",
  "bugs": {
    "url": "https://github.com/bysages/elements/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/elements"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vue": {
      "types": "./dist/vue/chart.d.mts",
      "import": "./dist/vue/chart.mjs"
    },
    "./react": {
      "types": "./dist/react/chart.d.mts",
      "import": "./dist/react/chart.mjs"
    },
    "./solid": {
      "types": "./dist/solid/chart.d.mts",
      "import": "./dist/solid/chart.mjs"
    },
    "./svelte": {
      "types": "./dist/svelte/chart.d.mts",
      "import": "./dist/svelte/chart.mjs"
    }
  },
  "scripts": {
    "dev": "basis build --stub",
    "build": "vp pack",
    "publish": "basis publish"
  },
  "dependencies": {
    "@bysages/core": "workspace:*",
    "@tanstack/charts": "0.18.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "solid-js": ">=1.8",
    "svelte": "^5.20.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "rollup-plugin-svelte": "7.2.3",
    "svelte": "5.57.0"
  }
}
