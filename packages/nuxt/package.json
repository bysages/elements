{
  "name": "@bysages/nuxt",
  "version": "0.0.0",
  "description": "Nuxt module for By Sages Elements — auto-imports the paper-and-ink Vue components and applies the theme",
  "keywords": [
    "design-system",
    "elements",
    "nuxt",
    "nuxt-module",
    "theming",
    "vue"
  ],
  "homepage": "https://github.com/bysages/elements#readme",
  "bugs": {
    "url": "https://github.com/bysages/elements/issues"
  },
  "license": "MIT",
  "author": {
    "name": "By Sages",
    "email": "contact@bysages.com",
    "url": "https://www.bysages.com/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bysages/elements"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "dev": "nuxt-module-build build --stub",
    "build": "nuxt-module-build build"
  },
  "dependencies": {
    "@bysages/core": "workspace:*",
    "@bysages/vue": "workspace:*",
    "@nuxt/kit": "4.5.2"
  },
  "devDependencies": {
    "@nuxt/module-builder": "1.0.3",
    "nuxt": "4.5.2"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0"
  }
}
