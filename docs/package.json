{
  "name": "@bysages/docs-site",
  "version": "0.0.0",
  "private": true,
  "description": "The Elements documentation site, on the docs-theme layer",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build:workbench": "pnpm --filter @bysages/vue build:workbench && pnpm --filter @bysages/react build:workbench",
    "build:links": "tsx scripts/generate-storybook-links.ts",
    "build": "pnpm run build:workbench && pnpm run build:links && nuxt build"
  },
  "dependencies": {
    "@bysages/charts": "workspace:*",
    "@bysages/docs-theme": "workspace:*",
    "@bysages/icons": "workspace:*",
    "@bysages/workflow": "workspace:*",
    "@internationalized/date": "3.12.4",
    "@json-render/core": "0.22.0",
    "@json-render/vue": "0.22.0",
    "@nuxtjs/i18n": "10.6.0",
    "@tanstack/markdown": "1.2.0",
    "minisearch": "7.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "nuxt": "4.6.4",
    "tailwindcss": "4.3.5"
  }
}
